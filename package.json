{
  "name": "cadence",
  "version": "0.1.0",
  "description": "A modern music player for macOS",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:webpack\" \"npm run dev:electron\"",
    "dev:webpack": "webpack --config webpack.config.js --watch",
    "dev:electron": "nodemon --watch dist/main.js --exec \"electron .\"",
    "build": "webpack --config webpack.config.js --mode production && electron-builder",
    "tree": "tree --noreport -I \"node_modules\" > ./tree.txt",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austinthaldorfhuelsbeck/cadence.git"
  },
  "author": "Austin Thaldorf-Huelsbeck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/austinthaldorfhuelsbeck/cadence/issues"
  },
  "homepage": "https://github.com/austinthaldorfhuelsbeck/cadence#readme",
  "build": {
    "appId": "com.balustrade.cadence",
    "mac": {
      "category": "public.app-category.music"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.3",
    "nodemon": "^3.1.9",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "electron-squirrel-startup": "^1.0.1",
    "howler": "^2.2.4",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.3.0",
    "redux": "^5.0.1",
    "uuid": "^11.1.0",
    "wavesurfer.js": "^7.9.1"
  }
}
